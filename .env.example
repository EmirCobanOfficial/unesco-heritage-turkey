# ------------------------------------------------------------------
# Örnek ortam değişkenleri / Example environment variables
# Bu dosyayı ".env" olarak kopyalayıp değerleri doldurun:
#   cp .env.example .env
# ".env" dosyası .gitignore ile hariç tutulmuştur; asla commit'lemeyin.
# ------------------------------------------------------------------

# Sunucu portu / HTTP server port
PORT=3000

# --- SQL Server (MSSQL) bağlantı bilgileri / connection settings ---
DB_USER=
DB_PASSWORD=
# Örn: localhost  ya da  localhost\SQLEXPRESS  (adlandırılmış örnek)
DB_SERVER=
DB_DATABASE=

# Şifreleme ayarları / encryption options (true varsayılan)
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# ------------------------------------------------------------------
# NOT: Google Maps API anahtarı istemci (tarayıcı) tarafında çalışır ve
# .env üzerinden gizlenemez. Anahtarınızı web/harita.html içindeki
# YOUR_GOOGLE_MAPS_API_KEY placeholder'ı ile değiştirin ve Google Cloud
# Console'da HTTP referrer kısıtlaması uygulayın.
# ------------------------------------------------------------------
